#!/bin/bash
age=20
if [ $age -ge 18 ]
then
    echo "Adult"
else
    echo "Minor"
fi
#3--Sample Python code in bash-----
age = int(input("Enter age"))
if age >= 18:
   print("You are Adult")
else:
   print("You are Minor")